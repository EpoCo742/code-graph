{
  "name": "@codegraph/aggregator",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codegraph-aggregate": "./dist/cli.js",
    "codegraph-diff": "./dist/diff-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",

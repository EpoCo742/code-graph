{
  "name": "@codegraph/extractor",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "codegraph-extract": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/*.test.js",
    "extract:samples": "node scripts/extract-samples.mjs"
  },
  "dependencies": {
    "@codegraph/schema": "*",
    "fast-glob": "^3.3.2",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.27.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^24.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/code-graph.git",
    "directory": "packages/extractor"
  }
}
